# Copy to frontend/.env and fill real values.
# NEVER commit the real .env file.

# Supabase Project URL (Settings -> API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase anon public key (Settings -> API)
# Requires proper RLS. NEVER use service_role here.
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# GitHub Pages base path (injected automatically in CI)
# VITE_BASE_PATH=/App/
